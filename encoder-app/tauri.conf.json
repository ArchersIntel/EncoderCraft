{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EncoderCraft",
  "version": "0.1.0",
  "identifier": "dev.artcraft.encodercraft",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EncoderCraft",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
